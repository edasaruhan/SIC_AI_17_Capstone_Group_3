# ARGUS reads paths from YAML configuration. This file intentionally contains
# no credentials. It exists as a safe starting point for later optional layers.
ARGUS_LOG_LEVEL = INFO

# Optional corporate-style demo login. Set both values together in the local environment.
# ARGUS_DEMO_EMAIL=analyst@institution.example
# ARGUS_DEMO_PASSWORD=replace-with-a-local-demo-password
